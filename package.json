{
  "name": "tokenomics-engine",
  "private": true,
  "scripts": {
    "generate:schemas": "pnpm -F @tokenomics/contracts generate:schemas",
    "check:schemas": "pnpm -F @tokenomics/contracts check:schemas",
    "check:literals": "node scripts/check-literals.mjs --check",
    "record:literals": "node scripts/check-literals.mjs --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
