{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OutputPrior",
  "$defs": {
    "OutputPrior": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "band": {
          "$ref": "#/$defs/OutputBand"
        },
        "output_tokens": {
          "type": "object",
          "properties": {
            "p50": {
              "type": "number",
              "minimum": 0
            },
            "p90": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "p50",
            "p90"
          ]
        },
        "reasoning_tokens": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "p50": {
                  "type": "number",
                  "minimum": 0
                },
                "p90": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "p50",
                "p90"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "n_samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seed_provenance": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/SeedProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "model_id",
        "band",
        "output_tokens",
        "n_samples",
        "provenance"
      ]
    },
    "OutputBand": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long",
        "unbounded"
      ]
    },
    "SeedProvenance": {
      "type": "string",
      "enum": [
        "SEED_UNCALIBRATED",
        "CALIBRATED_FROM_OBSERVED",
        "USER_SUPPLIED_BASELINE"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/Method"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "source_class": {
          "$ref": "#/$defs/SourceClass"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_by": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "confidence",
        "source_class",
        "source_url",
        "verified_at"
      ]
    },
    "Method": {
      "type": "string",
      "enum": [
        "EXACT_TOKENIZER",
        "PROVIDER_COUNT_API",
        "PROVIDER_FORMULA",
        "MEASURED_PROBE",
        "MEASURED_BENCHMARK",
        "TOKENIZER_SCALED",
        "CALIBRATED_HEURISTIC",
        "EXACT_PROXY",
        "USER_SUPPLIED",
        "DERIVED",
        "UNAVAILABLE"
      ]
    },
    "Confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "SourceClass": {
      "type": "string",
      "enum": [
        "VENDOR_PAGE",
        "VENDOR_CONFIG",
        "VENDOR_DOCS",
        "AGGREGATOR",
        "MEASURED",
        "USER_ENTERED"
      ]
    }
  },
  "title": "OutputPrior",
  "$comment": "GENERATED from /packages/contracts/src — do not hand-edit. Run `pnpm generate:schemas`. CI fails if this file differs from the regenerated output (§A2)."
}
