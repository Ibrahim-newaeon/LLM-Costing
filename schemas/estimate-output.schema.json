{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EstimateOutput",
  "$defs": {
    "EstimateOutput": {
      "type": "object",
      "properties": {
        "estimate_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scenario_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "pricing_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          }
        },
        "recommendations": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Recommendations"
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_models": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExcludedModel"
          }
        },
        "optimization_report": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/Optimization"
          }
        },
        "breakeven": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Breakeven"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assumption"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "missing_data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MissingDatum"
          }
        },
        "warnings": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/EstimateWarning"
          }
        },
        "system_overhead": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/SystemOverhead"
          }
        }
      },
      "required": [
        "estimate_id",
        "generated_at",
        "pricing_snapshot_id",
        "candidates",
        "assumptions",
        "evidence",
        "confidence",
        "needs_human_review",
        "missing_data"
      ]
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Tier"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployment_mode": {
          "$ref": "#/$defs/DeploymentMode"
        },
        "data_residency_region": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "is_prc_hosted": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EstimateLine"
          }
        },
        "total_tokens": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "input": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Range"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "output": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Range"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reasoning": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Range"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cached": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Range"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "total_cost": {
          "$ref": "#/$defs/Range"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "display_currency": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ]
        },
        "fx_rate_ref": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "self_hosted_detail": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/SelfHostedDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_multipliers": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/RequestMultipliers"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "model_id",
        "provider_id",
        "deployment_mode",
        "lines",
        "total_cost",
        "currency",
        "confidence"
      ]
    },
    "Tier": {
      "type": "string",
      "enum": [
        "FRONTIER",
        "MID",
        "LIGHTWEIGHT"
      ]
    },
    "DeploymentMode": {
      "type": "string",
      "enum": [
        "API_MANAGED",
        "SELF_HOSTED",
        "DEDICATED_CAPACITY"
      ]
    },
    "EstimateLine": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "$ref": "#/$defs/CostComponent"
        },
        "quantity": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/CostUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate_record_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_safety_quantity": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "tier": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenizer_proxy": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/TokenizerProxyUse"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/CacheOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "note": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task_id",
        "component",
        "method",
        "confidence"
      ]
    },
    "CostComponent": {
      "type": "string",
      "enum": [
        "prompt_input",
        "framing_overhead",
        "tool_schema",
        "conversation_history",
        "image_tiles",
        "audio_duration",
        "video_frames",
        "completion_output",
        "reasoning_output",
        "cache_read",
        "cache_write",
        "cache_storage",
        "per_request_fee",
        "tool_use_system_prompt",
        "server_tool_call",
        "gpu_seconds",
        "idle_gpu",
        "storage",
        "egress",
        "ops_labour"
      ]
    },
    "Range": {
      "type": "object",
      "properties": {
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p90": {
          "type": "number",
          "minimum": 0
        },
        "p99": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "p50",
        "p90"
      ]
    },
    "CostUnit": {
      "type": "string",
      "enum": [
        "tokens",
        "tiles",
        "images",
        "megapixels",
        "seconds",
        "requests",
        "gb",
        "months"
      ]
    },
    "Method": {
      "type": "string",
      "enum": [
        "EXACT_TOKENIZER",
        "PROVIDER_COUNT_API",
        "PROVIDER_FORMULA",
        "MEASURED_PROBE",
        "MEASURED_BENCHMARK",
        "TOKENIZER_SCALED",
        "CALIBRATED_HEURISTIC",
        "EXACT_PROXY",
        "USER_SUPPLIED",
        "DERIVED",
        "UNAVAILABLE"
      ]
    },
    "TokenizerProxyUse": {
      "type": "object",
      "properties": {
        "target_model": {
          "type": "string",
          "minLength": 1
        },
        "proxy_model": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "$ref": "#/$defs/ProxyBasis"
        },
        "measured_delta_pct": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "target_model",
        "proxy_model",
        "basis"
      ]
    },
    "ProxyBasis": {
      "type": "string",
      "enum": [
        "SCRIPT_AND_ARCHITECTURE_MATCH",
        "ARCHITECTURE_ONLY",
        "UNVALIDATED"
      ]
    },
    "CacheOutcome": {
      "type": "object",
      "properties": {
        "hit": {
          "type": "boolean"
        },
        "key_includes_tokenizer_revision": {
          "type": "boolean"
        }
      },
      "required": [
        "hit",
        "key_includes_tokenizer_revision"
      ]
    },
    "Confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "Currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "SelfHostedDetail": {
      "type": "object",
      "properties": {
        "instance_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rate_basis": {
          "$ref": "#/$defs/RateBasis"
        },
        "vram_feasible": {
          "type": "boolean"
        },
        "required_vram_gib": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "available_vram_gib": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "weights_vram_gib": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "kv_cache_vram_gib": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "activation_vram_gib": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "request_seconds": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        },
        "prefill_share_pct": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "utilization_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "utilization_is_derived": {
          "default": false,
          "type": "boolean"
        },
        "idle_cost_per_day": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "ops_labour_monthly": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rate_basis",
        "vram_feasible",
        "utilization_factor"
      ]
    },
    "RateBasis": {
      "type": "string",
      "enum": [
        "ON_DEMAND",
        "SPOT"
      ]
    },
    "RequestMultipliers": {
      "type": "object",
      "properties": {
        "service_tier": {
          "$ref": "#/$defs/ServiceTier"
        },
        "service_tier_multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "region": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "residency_uplift_pct": {
          "type": "number",
          "minimum": 0
        },
        "combined_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "service_tier",
        "service_tier_multiplier",
        "residency_uplift_pct",
        "combined_factor",
        "confidence"
      ]
    },
    "ServiceTier": {
      "type": "string",
      "enum": [
        "standard",
        "batch",
        "flex",
        "priority",
        "fast",
        "provisioned"
      ]
    },
    "Recommendations": {
      "type": "object",
      "properties": {
        "cheapest": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Recommendation"
            },
            {
              "type": "null"
            }
          ]
        },
        "best_capability": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Recommendation"
            },
            {
              "type": "null"
            }
          ]
        },
        "balanced": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Recommendation"
            },
            {
              "type": "null"
            }
          ]
        },
        "split_routing": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/SplitRouting"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Recommendation": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "deployment_mode": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/DeploymentMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_cost": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "$ref": "#/$defs/Rationale"
        }
      },
      "required": [
        "model_id",
        "rationale"
      ]
    },
    "Rationale": {
      "type": "object",
      "properties": {
        "triggering_metric": {
          "type": "string",
          "minLength": 1
        },
        "observed_value": {},
        "threshold": {},
        "evidence_ref": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "triggering_metric",
        "observed_value",
        "threshold"
      ]
    },
    "SplitRouting": {
      "type": "object",
      "properties": {
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "$ref": "#/$defs/Rationale"
              }
            },
            "required": [
              "task_id",
              "model_id",
              "rationale"
            ]
          }
        },
        "total_cost_p50": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "saving_vs_single_model_pct": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "assignments"
      ]
    },
    "ExcludedModel": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "$ref": "#/$defs/ExclusionReason"
        },
        "detail": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_id",
        "reason"
      ]
    },
    "ExclusionReason": {
      "type": "string",
      "enum": [
        "MISSING_MODALITY",
        "NO_TOOL_SUPPORT",
        "CONTEXT_TOO_SMALL",
        "DATA_RESIDENCY_BLOCKED",
        "RATE_MISSING",
        "RATE_STALE",
        "VRAM_INFEASIBLE",
        "TOKENIZER_UNAVAILABLE",
        "ASSET_EXCEEDS_CONSTRAINTS",
        "ESTIMATE_INCOMPLETE",
        "MODEL_NOT_IN_SERVICE"
      ]
    },
    "Optimization": {
      "type": "object",
      "properties": {
        "lever": {
          "$ref": "#/$defs/OptimizationLever"
        },
        "target_task_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "projected_saving_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "projected_saving_absolute": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        },
        "tradeoff": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "$ref": "#/$defs/Rationale"
        }
      },
      "required": [
        "lever",
        "projected_saving_pct",
        "rationale"
      ]
    },
    "OptimizationLever": {
      "type": "string",
      "enum": [
        "ENABLE_PROMPT_CACHING",
        "TRIM_CONVERSATION_HISTORY",
        "SUMMARIZE_ROLLUP",
        "DOWNSIZE_MODEL_FOR_TASK",
        "BATCH_REQUESTS",
        "REDUCE_IMAGE_RESOLUTION",
        "USE_LOW_DETAIL_VISION",
        "TRIM_TOOL_SCHEMAS",
        "LOWER_MAX_TOKENS",
        "AVOID_CONTEXT_TIER_THRESHOLD",
        "SWITCH_TO_SELF_HOSTED",
        "SWITCH_TO_API"
      ]
    },
    "Breakeven": {
      "type": "object",
      "properties": {
        "requests_per_day_crossover": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions_ref": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "series": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/BreakevenPoint"
          }
        }
      }
    },
    "BreakevenPoint": {
      "type": "object",
      "properties": {
